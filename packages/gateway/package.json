{
  "name": "@remote-ide/gateway",
  "productName": "Vibe Gateway",
  "description": "Local and SSH workspace launcher for Vibe Editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/entry.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node ../../scripts/start.mjs gateway",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run --environment happy-dom && npm run build && node --test dist-electron/*.test.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.2",
    "happy-dom": "^20.8.9",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.1",
    "ws": "^8.18.0"
  }
}
